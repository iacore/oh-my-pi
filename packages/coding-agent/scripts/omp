#!/bin/sh
# Dev launcher for the omp CLI, installed by `bun run setup`.
#
# Two launch paths, chosen by OMP_LAUNCH_MODE (default `auto`):
#
#   auto      run the standalone binary at packages/coding-agent/dist/omp,
#             rebuilding it only when the checkout's source generation moves
#             (git HEAD / tracked-dirty set / Bun version / the embedded native
#             addon). Falls back to the source path whenever the build is
#             unavailable, already in progress, or has failed for that same
#             generation — never blocking, never running a stale artifact.
#   ts        always `bun src/cli.ts` (the pre-cache-tuned dev loop; also forced
#             when PI_TIMING is set, since the module timer is a preload).
#
# `OMP_BUILD_ONLY=1` builds (or verifies) the artifact and exits without
# launching: 0 when the artifact is current, 1 when it cannot be built. The
# AoT builder `scripts/omp-aot` drives it so the expensive compile happens
# ahead of a launch instead of on top of one.
#
# The compiled binary embeds its own runtime and autoloads no bunfig/tsconfig/
# .env, so it needs neither the empty-directory dance below nor the preload
# shim; the source path still does.
#
# Why the empty directory matters for the source path: Bun reads `bunfig.toml`
# from the *current working directory* at startup and evaluates its `preload`
# entries before running the script. A bun-shebang bin (what `bun link` creates
# for `src/cli.ts`) therefore inherits whatever `preload` the directory you
# happen to be in declares. Running `omp`/`pi` inside an unrelated Bun project
# can execute — and crash on — that project's preload, e.g.
#   error: Cannot find module '@v12sh/utils/frontmatter' from '.../loader.ts'
#
# Bun only reads the *exact* cwd (it does not walk parents) and ignores
# `--config`/`BUN_BE_BUN` for this, so the fix is to launch Bun from an empty,
# bunfig-free directory and restore the real cwd inside the process via the
# preload shim alongside this file.
set -e

# Resolve this script's real location even when invoked through a symlink
# (`$HOME/.bun/bin/omp` -> this file).
self=$0
while [ -L "$self" ]; do
	link=$(readlink "$self")
	case $link in
	/*) self=$link ;;
	*) self=$(dirname "$self")/$link ;;
	esac
done
scripts_dir=$(CDPATH= cd -- "$(dirname -- "$self")" && pwd -P)
pkg_dir=$(CDPATH= cd -- "$scripts_dir/.." && pwd -P)
repo_root=$(CDPATH= cd -- "$pkg_dir/../.." && pwd -P)
cli=$scripts_dir/../src/cli.ts
preload=$scripts_dir/omp.ts
timing_preload=$scripts_dir/../../utils/src/module-timer.ts

artifact=$pkg_dir/dist/omp
build_log=$pkg_dir/dist/omp-build.log
lock_file=$pkg_dir/dist/.omp-build.lock # symlink whose target is the owner pid
build_child_file=$pkg_dir/dist/.omp-build-child.pid
state=$pkg_dir/dist/omp-launch.state

launch_dir=${OMP_DEV_LAUNCH_DIR:-${HOME}/.omp/.dev-cwd}

# Build-and-exit mode; see the header.
build_only=${OMP_BUILD_ONLY:-}

# Herdr 0.7.5 validates the foreground process name. The macOS shell can
# preserve OMP's identity while still running the development CLI through Bun.
run_identity() {
	if [ "${HERDR_ENV:-}" = 1 ] && [ "$(uname -s)" = Darwin ]; then
		exec -a omp "$@"
	fi
	exec "$@"
}

launch_source() {
	if [ -n "$build_only" ]; then
		echo "omp: cannot produce the compiled CLI on this checkout (source-only fallback)" >&2
		exit 1
	fi
	# Bun reads bunfig.toml from the *current* directory at startup, so start it
	# empty and let the preload shim restore $PWD inside the process. Only this
	# path needs it: the compiled binary autoloads no bunfig and must keep the
	# user's real cwd, which is its project dir.
	mkdir -p "$launch_dir"
	OMP_LAUNCH_CWD=$PWD
	export OMP_LAUNCH_CWD
	cd "$launch_dir"
	if [ -n "${PI_TIMING:-}" ]; then
		run_identity bun --preload "$preload" --preload "$timing_preload" "$cli" "$@"
	fi
	run_identity bun --preload "$preload" "$cli" "$@"
}

# Newest mtime of the native addon the build embeds; BSD and GNU stat differ.
addon_mtime() {
	set -- "$repo_root"/packages/natives/native/pi_natives.*.node
	[ -e "$1" ] || {
		echo 0
		return
	}
	stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || echo 0
}

# Everything the build output depends on, in one cheap line. Any tracked change
# to the checkout (pull, merge, edit, stage) moves at least one field; untracked
# scratch files do not, so creating a note or a `.codegraph/` index no longer
# forces a rebuild of an artifact they cannot affect.
#
# Build outputs are excluded: `bun run build` writes
# `packages/stats/src/embedded-client.generated.txt` and resets it afterwards, so
# a build that is killed between the two (cancelled AoT build, Ctrl-C, OOM)
# leaves it dirty — counting that as a source change would make the next
# successful build record a generation that is stale the moment it finishes, and
# the launch after it would rebuild the 76 s artifact again.
#
# The working-tree *content* is hashed too: `status --porcelain` only names the
# dirty paths, so a second edit to an already-dirty file (the normal state of a
# checkout being worked on) would leave the generation unchanged and keep a
# stale artifact. `difft` is this box's `diff.external`, hence `--no-ext-diff`;
# the pair costs ~20 ms.
bun --version >/dev/null 2>&1 || launch_source "$@"
generation() {
	{
		bun --version
		git -C "$repo_root" rev-parse HEAD 2>/dev/null || echo nogit
		git -C "$repo_root" status --porcelain --untracked-files=no -- . \
			':(exclude)packages/stats/src/embedded-client.generated.txt' \
			':(exclude)packages/coding-agent/src/export/html/tool-views.generated.js' 2>/dev/null
		git -C "$repo_root" diff --no-ext-diff HEAD -- . \
			':(exclude)packages/stats/src/embedded-client.generated.txt' \
			':(exclude)packages/coding-agent/src/export/html/tool-views.generated.js' 2>/dev/null | cksum
		addon_mtime
	} | cksum
}

[ "${OMP_LAUNCH_MODE:-auto}" = ts ] && launch_source "$@"
[ -n "${PI_TIMING:-}" ] && launch_source "$@"
git -C "$repo_root" rev-parse --git-dir >/dev/null 2>&1 || launch_source "$@"

mkdir -p "$pkg_dir/dist"
generation=$(generation)
recorded=$(cat "$state" 2>/dev/null || true)

run_compiled() {
	run_identity "$artifact" "$@"
}

# A build is a tree (`bun run build` -> `bun scripts/build-binary.ts` -> the
# generators), so killing the recorded pid alone leaves compilers running that
# could land an artifact after a newer build did. Walk and stop the whole tree.
tree_of() {
	ps -eo pid=,ppid= | awk -v root="$1" '
		{ kids[$2] = kids[$2] " " $1 }
		END {
			n = 0; q[++n] = root
			while (n > 0) {
				p = q[n--]; print p
				m = split(kids[p], c, " ")
				for (i = 1; i <= m; i++) if (c[i] != "") q[++n] = c[i]
			}
		}'
}

alive_any() {
	for p in $1; do
		[ -r "/proc/$p/stat" ] && return 0
	done
	return 1
}

stop_tree() {
	tree=$(tree_of "$1")
	kill -s TERM $tree 2>/dev/null || true
	i=0
	while [ "$i" -lt 30 ] && alive_any "$tree"; do
		sleep 0.1
		i=$((i + 1))
	done
	if alive_any "$tree"; then
		kill -s KILL $tree 2>/dev/null || true
	fi
}

# One builder at a time; a launcher takes the source path instead of waiting,
# a build request waits — it has nothing else to do. The recorded pid lets a
# builder killed outright (SIGKILL, OOM) leave a lock that the next one clears
# instead of blocking every future build forever; the orphaned `bun run build`
# that such a kill leaves behind is stopped first, so two compiles never write
# the artifact (the build also renames into place atomically, so even a
# survivor cannot leave a half-written binary).
reap_orphan_build() {
	orphan=$(cat "$build_child_file" 2>/dev/null || true)
	rm -f "$build_child_file"
	case $orphan in
	'' | *[!0-9]*) return 0 ;;
	esac
	[ -r "/proc/$orphan/cmdline" ] || return 0
	tr '\0' ' ' <"/proc/$orphan/cmdline" | grep -q 'bun run build' || return 0
	echo "omp: stopping an orphaned build tree (pid $orphan) left by a killed launcher" >&2
	stop_tree "$orphan"
}

lock_owner_live() {
	owner=$(readlink "$lock_file" 2>/dev/null || true)
	case $owner in
	'' | *[!0-9]*) return 1 ;;
	esac
	[ -r "/proc/$owner/cmdline" ] && tr '\0' ' ' <"/proc/$owner/cmdline" | grep -q 'scripts/omp '
}

# The lock is a symlink whose target is the owner's pid. `ln -s` either creates
# it or fails, and the owner is readable the instant it exists — a `mkdir` lock
# has a window where the directory exists with no pid inside, which another
# launcher reads as a dead lock and clears.
take_lock() {
	ln -s "$$" "$lock_file" 2>/dev/null && return 0
	# A directory here is the previous lock format; drop it and try again.
	if [ -d "$lock_file" ]; then
		rm -rf "$lock_file"
		ln -s "$$" "$lock_file" 2>/dev/null && return 0
	fi
	# Liveness by cmdline, not `kill -0`: a zombie still answers `kill -0`, and a
	# recycled pid would make the lock permanent. Only a live dev launcher
	# (`scripts/omp ` — not `scripts/omp.ts`) holds this lock.
	lock_owner_live && return 1
	reap_orphan_build
	rm -f "$lock_file"
	ln -s "$$" "$lock_file" 2>/dev/null && return 0
	return 1
}

# Stop a compile orphaned by a launcher that was killed outright *before* the
# artifact is trusted — including on the fresh-artifact path, which never takes
# the lock. Left alone, that orphan finishes later and renames a binary built
# from an older tree over the current one while the recorded generation still
# claims the newer tree, which is silent staleness rather than a failed build.
if ! lock_owner_live; then
	reap_orphan_build
	rm -rf "$lock_file"
fi

# Fresh artifact for this generation: run it.
if [ -x "$artifact" ] && [ "$recorded" = "$generation ok" ]; then
	[ -n "$build_only" ] && exit 0
	run_compiled "$@"
fi

# Already tried and failed for this generation: do not pay the build again.
# A build request, unlike a launch, is an explicit "try again".
if [ "$recorded" = "$generation failed" ] && [ -z "$build_only" ]; then
	launch_source "$@"
fi

if ! take_lock; then
	[ -z "$build_only" ] && launch_source "$@"
	echo "omp: another build holds the lock; waiting for it..." >&2
	waited=0
	while ! take_lock; do
		if [ "$waited" -ge 1200 ]; then
			echo "omp: build lock still held after 600s; giving up" >&2
			exit 1
		fi
		sleep 0.5
		waited=$((waited + 1))
	done
fi
build_child=
stop_build() {
	rm -f "$lock_file" 2>/dev/null || true
	if [ -n "$build_child" ]; then
		stop_tree "$build_child"
	fi
	rm -f "$build_child_file"
	exit 143
}
trap 'rm -f "$lock_file" 2>/dev/null || true' 0
trap stop_build 1 2 15

echo "omp: building the compiled CLI (sources changed since the last build)..." >&2
build_started=$(date +%s)
(cd "$pkg_dir" && exec bun run build) >"$build_log" 2>&1 &
build_child=$!
echo "$build_child" >"$build_child_file"
build_status=0
wait "$build_child" || build_status=$?
build_child=
rm -f "$build_child_file"
if [ "$build_status" -eq 0 ] && { [ ! -x "$artifact" ] || [ "$(stat -c %Y "$artifact" 2>/dev/null || stat -f %m "$artifact")" -lt "$build_started" ]; }; then
	build_status=1
fi
if [ "$build_status" -eq 0 ]; then
	echo "$generation ok" >"$state"
	rm -f "$lock_file" 2>/dev/null || true
	trap - 0 1 2 15
	[ -n "$build_only" ] && exit 0
	run_compiled "$@"
fi

rm -f "$lock_file" 2>/dev/null || true
trap - 0 1 2 15

# A build killed by a signal was cancelled — by a newer `scripts/omp-aot`
# request, by Ctrl-C, by the OOM killer. Recording it as `failed` would make the
# next launch skip the rebuild and run from source, so leave the recorded state
# alone and let the caller decide.
if [ "$build_status" -ge 128 ]; then
	echo "omp: build interrupted by signal $((build_status - 128)); recorded state unchanged" >&2
	exit "$build_status"
fi

echo "$generation failed" >"$state"
tail -n 15 "$build_log" >&2 || true
if [ -n "$build_only" ]; then
	echo "omp: build failed" >&2
	exit 1
fi
echo "omp: build failed; running from source" >&2
launch_source "$@"
